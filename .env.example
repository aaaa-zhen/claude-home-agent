# Home Assistant (via Cloudflare Tunnel)
HA_URL=https://your-ha-domain.example.com/api
HA_TOKEN=your_ha_long_lived_access_token

# Home Assistant SSH (via Cloudflare Tunnel or VPN)
HA_SSH_HOST=your-ha-domain.example.com
HA_SSH_PORT=22
HA_SSH_USER=root
HA_SSH_PASS=changeme

# Amap (Gaode) API
AMAP_KEY=your_amap_key
DEFAULT_CITY=北京

# Cloudflare Tunnel health check URL
TUNNEL_URL=https://your-ha-domain.example.com

# 快递100（寄件价格查询）
KUAIDI100_KEY=your_kuaidi100_key
KUAIDI100_SECRET=your_kuaidi100_secret
KUAIDI100_CUSTOMER=your_kuaidi100_customer

# 顺丰（沙箱下单）
SF_PARTNER_ID=your_sf_partner_id
SF_CHECK_WORD=your_sf_check_word
# SF_API_URL=https://sfapi-sbox.sf-express.com/std/service

# Android app 推送 API
APP_API_TOKEN=your_app_api_token

# Telegram（可选，多频道推送）
TELEGRAM_BOT_TOKEN=your_bot_token
TG_DAILY_CHAT_ID=
TG_CHANNEL_ENGLISH=@your_english_channel
TG_CHANNEL_PODCAST=@your_podcast_channel
TG_CHANNEL_HOME=@your_home_channel
TG_CHANNEL_REMINDER=@your_reminder_channel
TG_CHANNEL_ENV=@your_env_channel

# 其他工具（按需）
RAPIDAPI_KEY=your_rapidapi_key
DIDI_MCP_URL=your_didi_mcp_url
DIDI_MCP_KEY=your_didi_mcp_key
AIHUBMIX_API_KEY=your_aihubmix_key
