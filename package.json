{
  "name": "weixin-agent-runtime",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "./start.sh",
    "reading:digest": "node reading-digest.mjs",
    "reading:dry-run": "node reading-digest.mjs --dry-run",
    "backup:memory": "./backup-memory.sh",
    "cleanup:tmp": "./cleanup-tmp.sh",
    "cleanup:videos": "./scripts/cleanup-downloaded-videos.sh",
    "cleanup:videos:dry-run": "./scripts/cleanup-downloaded-videos.sh --dry-run",
    "session:status": "./venv/bin/python services/session-manager.py status --json",
    "session:check": "./venv/bin/python services/session-manager.py check --dry-run",
    "test:session-manager": "./venv/bin/python -m unittest -v tests.test_session_manager",
    "apple:build": "./apple_bridge/build.sh",
    "apple:doctor": "./scripts/apple-bridge.sh doctor",
    "apple:permissions": "./scripts/apple-bridge.sh permissions",
    "test:apple-bridge": "./tests/test-apple-bridge.sh",
    "browser:doctor": "node scripts/browser-bridge.mjs doctor",
    "browser:tabs": "node scripts/browser-bridge.mjs tabs",
    "test:browser-bridge": "node --test tests/test_browser_bridge.mjs",
    "test:memory-apply": "node --test tests/test_memory_apply.mjs",
    "memory:optimize": "node scripts/memory-optimize.mjs daily",
    "memory:optimize:dry-run": "node scripts/memory-optimize.mjs daily --dry-run",
    "memory:report": "node scripts/memory-optimize.mjs weekly",
    "memory:distill": "bash scripts/memory-distill.sh manual",
    "memory:context": "node scripts/memory-apply.mjs --context",
    "memory:reviews": "node scripts/memory-apply.mjs --pending-reviews",
    "memory:backfill": "node scripts/memory-apply.mjs --backfill",
    "memory:apply": "node scripts/memory-apply.mjs --stdin",
    "healthcheck": "./healthcheck.sh",
    "agent:browser": "node scripts/agent-browser-open.mjs",
    "agent:preply": "node scripts/agent-browser-preply.mjs",
    "remote:list": "./venv/bin/python core/remote_hosts.py list --status",
    "remote:connect-url": "./venv/bin/python core/remote_hosts.py connect-url",
    "codex:doctor": "./venv/bin/python core/codex_task.py doctor",
    "codex:run": "./venv/bin/python core/codex_task.py run",
    "claude:doctor": "./venv/bin/python core/claude_task.py doctor",
    "claude:run": "./venv/bin/python core/claude_task.py run",
    "agentos:init": "./venv/bin/python -m agent_os init",
    "agentos:classify": "./venv/bin/python -m agent_os classify",
    "agentos:gateway": "./venv/bin/python -m agent_os gateway",
    "agentos:submit": "./venv/bin/python -m agent_os submit",
    "agentos:work:control": "./venv/bin/python -m agent_os work --worker control",
    "agentos:work:agent": "./venv/bin/python -m agent_os work --worker agent",
    "agentos:work:job": "./venv/bin/python -m agent_os work --worker job",
    "agentos:list": "./venv/bin/python -m agent_os list",
    "agentos:cancel": "./venv/bin/python -m agent_os cancel",
    "agentos:folders": "./venv/bin/python -m agent_os folders",
    "agentos:responses": "./venv/bin/python -m agent_os responses",
    "agentos:trace": "./venv/bin/python -m agent_os trace",
    "agentos:install-control-worker": "bash scripts/install-agent-os-control-worker.sh",
    "agentos:install-workers": "bash scripts/install-agent-os-workers.sh"
  },
  "dependencies": {
    "@anthropic-ai/claude-code": "^2.1.280",
    "@zed-industries/claude-agent-acp": "0.23.0",
    "@zed-industries/codex-acp": "0.10.0",
    "playwright": "^1.61.1",
    "undici": "^8.5.0",
    "weixin-acp": "0.6.0"
  }
}
